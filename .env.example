# Copy to .env.local for local development.
# Set these in Cloudflare Workers → Settings → Variables and Secrets for production.

# Google Sheets direct integration (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
