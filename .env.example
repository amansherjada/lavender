# Copy to .env.local for local development.
# Add these variables in Vercel → Project Settings → Environment Variables.
NEXT_PUBLIC_PABBLY_WEBHOOK_URL=https://connect.pabbly.com/workflow/sendwebhookdata/YOUR_KEY

